<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title data-inertia>Point ClickUp</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {{-- Le navigateur peint son cadre avant la feuille de style : sans ça, un
         thème sombre s'ouvre sur un éclair blanc. --}}
    <meta name="color-scheme" content="dark light" />

    @viteReactRefresh()
    @vite(['inertia/app.tsx'])
    @inertiaHead()
    @stack('dumper')
  </head>

  <body>
    @inertia()
  </body>

</html>
