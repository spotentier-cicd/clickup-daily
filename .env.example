# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
# Généré par « node ace generate:key »
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# ClickUp — la seule valeur indispensable
# Jeton personnel « pk_… » : ClickUp → avatar → Settings → Apps → API Token
CLICKUP_API_TOKEN=

# Facultatif : force l'équipe quand le jeton en voit plusieurs.
# Laissez vide, l'équipe se choisit dans /parametres.
CLICKUP_TEAM_ID=

# Facultatif : nom du fichier SQLite dans tmp/
DB_FILENAME=db.sqlite3

# ─ Conteneurs (docker compose) ───────────────────────────────────────────────
# Heure et jours de la collecte automatique. 1 = lundi.
COLLECT_AT=08:00
COLLECT_DAYS=1,2,3,4,5

# Dépôts git à monter en lecture seule dans le conteneur, s'il y en a.
# REPOS_DIR=/Users/moi/Documents/projects

# Transcriptions Claude Code, montées en lecture seule pour le coût des
# conversations. Par défaut ~/.claude ; à renseigner si elles sont ailleurs.
# CLAUDE_DIR=/Users/moi/.claude
